<!-- 雷達 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 雷達尺寸 -->
    <xacro:property name="radar_radius" value="0.1"/>
    <xacro:property name="radar_height" value="0.1"/>

    <!-- 雷達偏移量 (相對 base_link = 後輪軸中心)。階段 38：
         x = vehicle.yaml lidar_x (measured_coarse 0.30 ± 0.08，量測基準點未確認)
         z = lidar_z_ground - rear_wheel_radius (lidar_z_ground 0.55 是 provisional，未量測)
         實車由 allow_provisional 閘門擋住，模擬放行。量測任務見 docs/measurement_worklist.md。
         (階段 37 以前是舊 base_link (車體中心) 上方 0.45 m，用來避開相機頂端) -->
    <xacro:property name="radar_joint_x" value="${vehicle['lidar_x']}"/>
    <xacro:property name="radar_joint_y" value="0.0"/>
    <xacro:property name="radar_joint_z" value="${lidar_z}"/>

    <!-- 顏色 -->
    <material name="blue">
        <color rgba="0.2 0.0 0.7 0.8"/>
    </material>

    <!-- 雷達幾何-->
    <link name="radar">
        <visual>
            <geometry>
                <cylinder radius="${radar_radius}" length="${radar_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <xacro:cylinder_inertia m="0.2" r="${radar_radius}" h="${radar_height}"/>
    </link>

    <!-- 雷達關聯到base_link -->
    <joint name="radar2base_link" type="fixed">
        <parent link="base_link"/>
        <child link="radar"/>
        <origin xyz="${radar_joint_x} ${radar_joint_y} ${radar_joint_z}"/>
    </joint>

    <gazebo reference="radar">
        <material>Gazebo/Blue</material>

        <sensor name="lidar" type="ray">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10.0</update_rate> <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples> <resolution>1.0</resolution>
                        <min_angle>-3.1415926</min_angle> <max_angle>3.1415926</max_angle>  </horizontal>
                </scan>
                <range>
                    <min>0.15</min> <max>12.0</max> <resolution>0.01</resolution> </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev> </noise>
            </ray>

            <plugin name="scan_node" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>radar</frame_name>
            </plugin>
        </sensor>
    </gazebo>
</robot>