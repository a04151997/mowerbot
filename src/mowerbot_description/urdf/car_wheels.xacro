<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="car_inertia.xacro"/>
    <xacro:property name="PI" value="3.1415926535897931"/>

    <!-- 車體與輪子尺寸來自 vehicle.yaml (car_base.xacro 載入的 vehicle) -->
    <xacro:property name="body_length" value="${vehicle['body_length']}"/>
    <xacro:property name="body_width" value="${vehicle['body_width']}"/>
    <xacro:property name="body_height" value="${vehicle['body_height']}"/>

    <xacro:property name="wheel_radius" value="${vehicle['wheel_radius']}"/>
    <xacro:property name="wheel_separation" value="${vehicle['wheel_separation']}"/>
    <xacro:property name="wheel_width" value="0.1"/> 
    <xacro:property name="wheel_mass" value="1.0"/> 
    
    <xacro:macro name="visual_wheel" params="prefix">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" o_rpy="${PI/2} 0 0"/>
        </link>
    </xacro:macro>

    <xacro:macro name="add_rear_wheel" params="prefix y_reflect">
        <xacro:visual_wheel prefix="${prefix}_rear" />
        <!-- y = +-wheel_separation/2；z 讓輪子剛好著地 = wheel_radius - base_link 離地高度。
             以前 y 是 body_width/2 + wheel_width/2 + 0.01、z 寫死 -0.26 (= 0.17 - 0.43)，
             量測值一換就會與 diff_drive 的 wheel_separation 對不上 / 輪子懸空或陷地。
             x = +-0.35 (軸距 0.70) 仍然寫死：vehicle.yaml 的 wheelbase 還是 TBD。 -->
        <joint name="${prefix}_rear_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_rear_wheel"/>
            <origin xyz="-0.35 ${y_reflect * wheel_separation / 2} ${wheel_radius - (car_height / 2.0 + ground_height)}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <gazebo reference="${prefix}_rear_wheel">
            <mu1>2.0</mu1>      <mu2>2.0</mu2>      <kp>1000000.0</kp>  <kd>10.0</kd>  <minDepth>0.001</minDepth>     </gazebo>
    </xacro:macro>

    <xacro:add_rear_wheel prefix="left"  y_reflect="1" />
    <xacro:add_rear_wheel prefix="right" y_reflect="-1" />

    <xacro:macro name="add_front_wheel" params="prefix y_reflect">
        <xacro:visual_wheel prefix="${prefix}_front" />
        <joint name="${prefix}_front_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_front_wheel"/>
            <origin xyz="0.35 ${y_reflect * wheel_separation / 2} ${wheel_radius - (car_height / 2.0 + ground_height)}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <gazebo reference="${prefix}_front_wheel">
            <mu1>0.1</mu1>      
            <mu2>0.0</mu2>      
            <kp>1000000.0</kp>  
            <kd>100.0</kd>    
            <minDepth>0.001</minDepth>  
        </gazebo>
    </xacro:macro>

    <xacro:add_front_wheel prefix="left"  y_reflect="1" />
    <xacro:add_front_wheel prefix="right" y_reflect="-1" />
</robot>