#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""幾何閘門 (階段 38 修正 1 的 C 節)。

放在 bringup_real.launch.py 與 demo.launch.py 的最前面：
其餘節點等它以 exit code 0 結束才會啟動；不通過就以 exit code 1 結束，
launch 隨之整個關掉。

參數：
  allow_provisional            實機預設 false、模擬預設 true
  provisional_override_reason  allow_provisional=false 時強制通行的理由 (非空字串，寫進 log)
"""
import sys

import rclpy
from rclpy.node import Node

from mowerbot_description import vehicle_geometry


def main():
    rclpy.init()
    node = Node('geometry_guard')
    node.declare_parameter('allow_provisional', False)
    node.declare_parameter('provisional_override_reason', '')
    allow = bool(node.get_parameter('allow_provisional').value)
    reason = str(node.get_parameter('provisional_override_reason').value)
    log = node.get_logger()
    code = 0
    try:
        geom = vehicle_geometry.load()
        log.info('車輛幾何：%s' % geom.summary())
        for level, text in vehicle_geometry.check_gate(geom, allow, reason):
            # rclpy 不允許同一個呼叫點用不同的嚴重度，所以 warn / info 分成兩個呼叫點
            for line in text.splitlines():
                if level == 'warn':
                    log.warn(line)
                else:
                    log.info(line)
        log.info('✅ 幾何閘門通過 (allow_provisional=%s)' % allow)
    except vehicle_geometry.GeometryError as exc:
        for line in str(exc).splitlines():
            log.fatal(line)
        log.fatal('❌ 幾何閘門不通過，整個 launch 停止')
        code = 1
    node.destroy_node()
    rclpy.shutdown()
    sys.exit(code)


if __name__ == '__main__':
    main()
